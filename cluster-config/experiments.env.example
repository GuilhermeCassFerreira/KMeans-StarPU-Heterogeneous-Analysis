# Copie para cluster-config/experiments.env e ajuste os valores.

# Modos: starpu_cpu, starpu_gpu, starpu_hybrid (separados por espaço)
MODES_RAW="starpu_cpu starpu_gpu starpu_hybrid"

# Contagens de nós MPI a testar.
NODE_COUNTS_RAW="2 4"

# Número de pontos fixo.
N=300000000
K=50
SEED=42
ITERS=30

# Chunks por nó para cada modo.
CHUNKS_CPU_PER_NODE=28
CHUNKS_GPU_PER_NODE=2
CHUNKS_HYBRID_PER_NODE=32

# Repetições por cenário (StarPU precisa de calibração).
WARMUP_REPS=2
TIMED_REPS=3

DO_SYNC=1
DO_BUILD=1
BUILD_CLEAN=1

# Flags de build para g6.4xlarge (NVIDIA L4, sm_89).
BUILD_ARGS_STARPU=""

# mpirun base args.
GLOBAL_MPIRUN_ARGS="--bind-to none"

# Salvar logs por run.
SAVE_LOGS=1
