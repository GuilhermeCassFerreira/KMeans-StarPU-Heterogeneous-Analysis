# Execução extra (fora das medições) do cenário deep para os gráficos: rastreamento FxT em
# /tmp/fxt/ de cada nó, estatísticas por worker e volume MPI.
source cluster-config/cenario_deep_escala.env
TIMED_REPS=1
GLOBAL_MPIRUN_ARGS+=" -x STARPU_FXT_TRACE=1 -x STARPU_FXT_PREFIX=/tmp/fxt/ -x STARPU_WORKER_STATS=1 -x STARPU_PROFILING=1 -x STARPU_MPI_STATS=1"
