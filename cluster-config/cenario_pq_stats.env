# Execução extra (fora das medições) do cenário pq: estatísticas por worker e volume MPI.
# Roda logo depois das medições do mesmo cenário, reaproveitando o input.bin já gerado.
source cluster-config/cenario_pq.env
DO_GENERATE=0
DO_BUILD=0
DO_SYNC=0
WARMUP_REPS=0
TIMED_REPS=1
GLOBAL_MPIRUN_ARGS+=" -x STARPU_WORKER_STATS=1 -x STARPU_PROFILING=1 -x STARPU_MPI_STATS=1"
