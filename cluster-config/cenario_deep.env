# Cenário Descritores Deep (N=20480000, K=256, D=96): StarPU híbrido
# Uso: bash cluster-config/run-experiments.sh --env cluster-config/cenario_deep.env --nodes 1 --session deep_np1

MODES_RAW="starpu_hybrid"
NODE_COUNTS_RAW="1"

N=20480000            # múltiplo de 1024
K=256
DIM=96
SEED=42
ITERS=30
INPUT_FILE="input.bin"    # mesmo nome nos 3 cenários: cada geração sobrescreve a anterior

# 1024 chunks no total com 1 ou 32 nós: mesmo tamanho de chunk, calibração reaproveitada
CHUNKS_HYBRID_PER_NODE=32
CHUNKS_HYBRID_TOTAL=1024

WARMUP_REPS=2
TIMED_REPS=3

DO_SYNC=1
DO_BUILD=1
BUILD_CLEAN=1
BUILD_ARGS_STARPU=""

GLOBAL_MPIRUN_ARGS="--bind-to none"
EXPECTED_COMPILER="nvc++"

SAVE_LOGS=1
