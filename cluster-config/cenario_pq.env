# Cenário Subvetores de PQ (N=102400000, K=256, D=16): StarPU híbrido
# Uso: bash cluster-config/run-experiments.sh --env cluster-config/cenario_pq.env --nodes 1 --session pq_np1

MODES_RAW="starpu_hybrid"
NODE_COUNTS_RAW="1"

N=102400000            # múltiplo de 1024
K=256
DIM=16
SEED=42
ITERS=30
INPUT_FILE="input.bin"    # mesmo nome nos 3 cenários: cada geração sobrescreve a anterior

# 1024 chunks no total até 8 nós: mesmo tamanho de chunk, calibração reaproveitada
CHUNKS_HYBRID_PER_NODE=32
CHUNKS_HYBRID_TOTAL=1024
# Pelo menos 128 chunks por nó: 1024 até 8 nós, 2048 com 16 e 4096 com 32. Com 32 nós e só
# 32 chunks por nó, uma tarefa de CPU durava ~70% da iteração (traces da AWS). Provisório:
# o valor por cenário sai do teste de granularidade em 1 nó. --chunks-min-per-node 0 volta
# ao total fixo de 1024
CHUNKS_HYBRID_MIN_PER_NODE=128

WARMUP_REPS=2
TIMED_REPS=3

DO_SYNC=1
DO_BUILD=1
BUILD_CLEAN=1
BUILD_ARGS_STARPU=""

GLOBAL_MPIRUN_ARGS="--bind-to none"
EXPECTED_COMPILER="nvc++"

SAVE_LOGS=1
