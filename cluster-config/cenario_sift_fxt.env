# Execução extra rastreada (FxT) do cenário SIFT, fora das medições, para o gráfico de Gantt por worker.
# Roda depois das medições do SIFT, reaproveitando o input.bin já gerado. Traces em /tmp/fxt/ de cada nó.
source cluster-config/cenario_sift.env
DO_GENERATE=0
DO_BUILD=0
DO_SYNC=0
WARMUP_REPS=0
TIMED_REPS=1
GLOBAL_MPIRUN_ARGS+=" -x STARPU_FXT_TRACE=1 -x STARPU_FXT_PREFIX=/tmp/fxt/"
