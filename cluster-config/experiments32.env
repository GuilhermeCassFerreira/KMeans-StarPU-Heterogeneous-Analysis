# Verificação de escala: StarPU híbrido em 32 nós, mesmo protocolo dos experimentos de junho.

MODES_RAW="starpu_hybrid"
NODE_COUNTS_RAW="32"

N=300000000
K=50
SEED=42
ITERS=30

CHUNKS_CPU_PER_NODE=28
CHUNKS_GPU_PER_NODE=1
CHUNKS_HYBRID_PER_NODE=32

# Junho: 2 calibrações + 3 medições (ver results/experiments/*/results.csv).
WARMUP_REPS=2
TIMED_REPS=3

DO_SYNC=1
DO_BUILD=1
BUILD_CLEAN=1
BUILD_ARGS_STARPU=""

GLOBAL_MPIRUN_ARGS="--bind-to none"

SAVE_LOGS=1
