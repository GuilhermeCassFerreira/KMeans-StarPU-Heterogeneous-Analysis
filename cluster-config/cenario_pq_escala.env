# Escalabilidade (1 a 32 nós) do cenário pq: medições sem aquecimento, com a calibração
# salva (1024 chunks com qualquer número de nós). Entrada própria do cenário, gerada uma vez.
source cluster-config/cenario_pq.env
INPUT_FILE="input_pq.bin"
DO_GENERATE=0
DO_SYNC=0
DO_BUILD=0
WARMUP_REPS=0
TIMED_REPS=5
FREEZE_CALIBRATION=1      # reinstala a calibração salva antes de cada execução
