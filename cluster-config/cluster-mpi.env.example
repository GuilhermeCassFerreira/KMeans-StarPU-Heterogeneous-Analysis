# Copie para cluster-config/cluster-mpi.env e ajuste os valores.

SSH_USER="ec2-user"
SSH_PORT=22
SSH_KEY="${HOME}/.ssh/id_rsa"
SSH_OPTIONS=(
  -o StrictHostKeyChecking=accept-new
  -o ConnectTimeout=10
)

REMOTE_REPO_DIR="/home/ec2-user/KMeans-StarPU-Heterogeneous-Analysis"

# IPs públicos dos nós (preencher após cluster spawn).
# Formatos aceitos:
#   ['123.123.123.123','111.111.111.111']
#   123.123.123.123,111.111.111.111
# Deixe vazio e use: ./cluster-config/cluster-mpi.sh set-ips "..."
CONTROL_IPS_RAW=""

# IPs privados para comunicação MPI (10.0.0.x).
# Se vazio e AUTO_RESOLVE_MPI_PRIVATE_IPS=1, resolve automaticamente via SSH.
MPI_IPS_RAW=""

AUTO_RESOLVE_MPI_PRIVATE_IPS=1

# IP privado do nó mestre (rank 0) — primeiro da lista gerada pelo hpcac-toolkit.
PREFERRED_MASTER_IP="10.0.0.10"

CONTROL_MASTER_IP=""
SLOTS_PER_HOST=1

# Defaults de build.
BUILD_TARGET="starpu"
BUILD_ARGS=""
BUILD_CLEAN_FIRST=0

# Defaults de run (StarPU Hybrid np=2 como exemplo).
RUN_TARGET="starpu"
RUN_ARGS="input.txt 50 output_bench/run 64 0 42 30"
RUN_NP=""
RUN_HOSTFILE=""
MPIRUN_BIN="mpirun"
MPIRUN_ARGS="--bind-to none"
MPIRUN_RSH_ARGS="-i ~/.ssh/id_ed25519_mpi -o StrictHostKeyChecking=accept-new"
AUTO_PREPARE_MPI_SSH=1
REMOTE_TRACE_DIR=""
TRACE_TOOL_BIN="starpu_fxt_tool"
